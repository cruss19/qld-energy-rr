# Local agent operating instructions (not part of the public project)
AGENTS.md

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*
!.env.example

# Editors and operating systems
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Credentials and keys
*.pem
*.key
*.pfx
*.p12
credentials*.json
secrets*.json

