data/raw/**
data/interim/**
data/processed/**
data/external/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!data/manifests/**
!data/fixtures/**

# Generated training and monitoring products
training_output/**
